pipeline {
    agent {
        docker {
            image 'node:18-alpine'
            args '-u root'
        }
    }
    
    environment {
        GIT_SHA = sh(script: 'apk add --no-cache git && git rev-parse --short HEAD', returnStdout: true).trim()
        EMAIL_RECIPIENTS = 'amina@kijanikiosk.com, osei@kijanikiosk.com'
    }
    
    stages {
        stage('Lint') {
            steps {
                sh 'echo "Starting Lint stage..."'
                sh 'node --version'
                sh 'npm --version'
                sh 'echo "Lint check passed"'
                sh 'exit 1'
            }
            post {
                failure {
                    sh 'echo "LINT STAGE FAILED - Intentional failure injected"'
                }
            }
        }
        
        stage('Build') {
            steps {
                sh 'echo "Starting Build stage..."'
                sh 'npm init -y'
                sh 'npm install jest --save-dev'
                sh 'echo "Build completed"'
            }
        }
        
        stage('Verify') {
            parallel {
                stage('Test') {
                    steps {
                        sh 'echo "Running Test stage..."'
                        sh '''
echo 'test("Addition test - should pass", () => {
    expect(1 + 1).toBe(2);
});' > addition.pass.test.js
'''
                        sh 'npx jest addition.pass.test.js'
                    }
                }
                
                stage('Security Audit') {
                    steps {
                        sh 'echo "Running Security Audit..."'
                        sh 'npm audit || echo "Audit completed"'
                        sh 'echo "Security audit done"'
                    }
                }
            }
        }
        
        stage('Archive') {
            steps {
                sh 'echo "Archiving artifacts..."'
                sh 'mkdir -p dist'
                sh 'echo "KijaniKiosk Payments API" > dist/README.md'
                sh 'apk add --no-cache zip'
                sh 'zip -r payments-${GIT_SHA}.zip dist/'
                archiveArtifacts artifacts: '*.zip', fingerprint: true
            }
        }
        
        stage('Publish') {
            steps {
                sh 'echo "Publishing to Nexus..."'
                sh 'echo "Artifact ready for publishing"'
            }
        }
    }
    
    post {
        always {
            cleanWs()
            sh 'echo "Workspace cleaned"'
        }
        success {
            sh 'echo "PIPELINE SUCCESS"'
        }
        failure {
            sh 'echo "PIPELINE FAILED - Lint stage failed intentionally"'
            emailext (
                to: "${EMAIL_RECIPIENTS}",
                subject: "❌ Jenkins Build Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
KijaniKiosk CI Pipeline - Build Failure Report

Build: ${env.JOB_NAME} #${env.BUILD_NUMBER}
Status: FAILED
Stage: Lint Stage (Intentional Failure)
Time: ${new Date()}
URL: ${env.BUILD_URL}

Error Details:
The Lint stage was intentionally failed to test the notification system.
This simulates what happens when code quality issues are detected.

The pipeline stopped at the Lint stage because an exit 1 was triggered.
All subsequent stages (Build, Test, Security Audit, Archive, Publish) were skipped.

This is a test of the email notification system for the KijaniKiosk pipeline.

Action Required:
Review the lint failure and ensure code quality standards are met.

---
This email was sent by Jenkins CI/CD Pipeline
KijaniKiosk DevOps Team
"""
            )
        }
        changed {
            script {
                if (currentBuild.previousBuild) {
                    sh 'echo "Status changed from previous build"'
                }
            }
        }
    }
}

# ============================================================
# Developed by: Cyrus Ogeto
# Project: KijaniKiosk Payments API
# Purpose: Production Docker image for the payments service
# ============================================================

# ============================================================
# Stage 1: Builder Stage
# ============================================================
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm install --only=production && \
    npm cache clean --force

# Copy the dist directory (index.js is already in here)
COPY dist ./dist

# ============================================================
# Stage 2: Production Stage
# ============================================================
FROM node:18-alpine

RUN addgroup -g 1001 -S kijani && \
    adduser -u 1001 -S kijani -G kijani

WORKDIR /app

COPY --from=builder --chown=kijani:kijani /app/node_modules ./node_modules
COPY --from=builder --chown=kijani:kijani /app/package*.json ./
COPY --from=builder --chown=kijani:kijani /app/dist ./dist

RUN mkdir -p /app/logs /app/config && \
    chown -R kijani:kijani /app

USER kijani

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

CMD ["node", "dist/index.js"]
